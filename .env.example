# SMTP mailer credentials
# Copy this file to ".env" and fill in real values. NEVER commit the real .env file.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Chromatic Softwares"

# Optional: delay in microseconds between each send to avoid provider rate limits
MAIL_SEND_DELAY_MICROSECONDS=750000

# Personal mailer credentials, used only by the resume-blast page (resume.php).
# Separate from the Chromatic Softwares MAIL_* settings above.
PERSONAL_MAIL_HOST=smtp.gmail.com
PERSONAL_MAIL_PORT=587
PERSONAL_MAIL_ENCRYPTION=tls
PERSONAL_MAIL_USERNAME=your-personal-email@gmail.com
PERSONAL_MAIL_PASSWORD=your-app-password

PERSONAL_MAIL_FROM_ADDRESS=your-personal-email@gmail.com
PERSONAL_MAIL_FROM_NAME="Your Name"
