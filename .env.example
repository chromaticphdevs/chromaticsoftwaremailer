# SMTP mailer credentials
# Copy this file to ".env" and fill in real values. NEVER commit the real .env file.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Chromatic Softwares"

# Optional: delay in microseconds between each send to avoid provider rate limits
MAIL_SEND_DELAY_MICROSECONDS=750000
